#.rst
# FinduFilterPicker
# ---------------------
#
# Finds the UUSS filter picker import library.
#
# Imported Targets
# ^^^^^^^^^^^^^^^^
#
# ``uFilterPicker_FOUND``
#   True indicates uFilterPicker was found.
# ``uFilterPicker::uFilterPicker``
#   The filter picker library, if found.
include(CMakeFindDependencyMacro)

find_dependency(TBB)

@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")
